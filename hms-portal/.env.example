# Database
# MongoDB replica set. Transactions in appointment booking and invoice payment
# require a replica set (Atlas, or a local mongod started with --replSet).
DATABASE_URL="mongodb+srv://user:password@cluster.example.mongodb.net/hms?retryWrites=true&w=majority"

# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-at-least-32-chars-long"

# Optional: OAuth providers
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
